{
  "name": "@scheduler/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.94",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.0",
    "@scheduler/api-client": "*",
    "@scheduler/types": "*",
    "@sentry/react-native": "^8.24.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@supabase/supabase-js": "^2.114.0",
    "@tanstack/react-query": "^5.102.8",
    "@ungap/structured-clone": "^1.4.0",
    "ai": "^7.0.86",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~54.0.33",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "zod": "^4.5.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.18",
    "jest": "~30.5.1",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.8",
    "test-renderer": "^1.2.0",
    "typescript": "~7.0.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|ai|@ai-sdk))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/../../node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock.js"
    },
    "collectCoverageFrom": [
      "lib/**/*.{ts,tsx}",
      "!lib/**/*.d.ts"
    ]
  }
}

{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "workplix" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_VARIANT": "workplix" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "workplix" }
    },
    "seaudecrabe-preview": {
      "distribution": "internal",
      "channel": "seaudecrabe-preview",
      "env": { "APP_VARIANT": "seaudecrabe" }
    },
    "seaudecrabe-production": {
      "autoIncrement": true,
      "channel": "seaudecrabe-production",
      "env": { "APP_VARIANT": "seaudecrabe" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "REPLACE_WITH_ASC_KEY_ID",
        "ascApiKeyIssuerId": "REPLACE_WITH_ASC_ISSUER_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
        "ascAppId": "REPLACE_WITH_WORKPLIX_ASC_APP_ID"
      }
    },
    "seaudecrabe-production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "REPLACE_WITH_ASC_KEY_ID",
        "ascApiKeyIssuerId": "REPLACE_WITH_ASC_ISSUER_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
        "ascAppId": "REPLACE_WITH_SEAUDECRABE_ASC_APP_ID"
      }
    }
  }
}

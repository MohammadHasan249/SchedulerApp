{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "workplix" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_VARIANT": "workplix" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "workplix" }
    },
    "seaudecrabe-preview": {
      "distribution": "internal",
      "channel": "seaudecrabe-preview",
      "env": { "APP_VARIANT": "seaudecrabe" }
    },
    "seaudecrabe-production": {
      "autoIncrement": true,
      "channel": "seaudecrabe-production",
      "env": { "APP_VARIANT": "seaudecrabe" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    },
    "seaudecrabe-production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}

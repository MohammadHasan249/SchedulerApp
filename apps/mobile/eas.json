{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "workplix" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_VARIANT": "workplix" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "APP_VARIANT": "workplix" }
    },
    "seaudecrabe-preview": {
      "distribution": "internal",
      "channel": "seaudecrabe-preview",
      "env": { "APP_VARIANT": "seaudecrabe" }
    },
    "seaudecrabe-production": {
      "autoIncrement": true,
      "channel": "seaudecrabe-production",
      "env": { "APP_VARIANT": "seaudecrabe" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "G4MK9LWCTZ",
        "ascApiKeyIssuerId": "38df7c34-a29b-4551-ad50-cc7a4691bc3d",
        "appleTeamId": "7U9UCS34XM",
        "ascAppId": "6806672197"
      }
    },
    "seaudecrabe-production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "G4MK9LWCTZ",
        "ascApiKeyIssuerId": "38df7c34-a29b-4551-ad50-cc7a4691bc3d",
        "appleTeamId": "7U9UCS34XM",
        "ascAppId": "6806707251"
      }
    }
  }
}
